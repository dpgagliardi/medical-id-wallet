project.manifest = manifest-edge.xml

# Device app build for Edge cycling computers from the Edge 540/840 on,
# which run device apps and data fields but not widgets. Same sources and
# resources as monkey.jungle; (:widgetApp) code is left out instead of
# (:deviceApp). All these devices are API 5.1.0+, so all get the QR encoder.
base.excludeAnnotations = noQrEncoder;widgetApp;edgeOpenHint

# BEGIN launcher icons (generated by store/icon/build_icons.py)
edge540.resourcePath = $(edge540.resourcePath);resources-launcher/35x35-edge
edge840.resourcePath = $(edge840.resourcePath);resources-launcher/35x35-edge
edgeexplore2.resourcePath = $(edgeexplore2.resourcePath);resources-launcher/36x36-edge
edgemtb.resourcePath = $(edgemtb.resourcePath);resources-launcher/36x36-edge
edge1040.resourcePath = $(edge1040.resourcePath);resources-launcher/40x40-edge
edge550.resourcePath = $(edge550.resourcePath);resources-launcher/56x56-edge
edge850.resourcePath = $(edge850.resourcePath);resources-launcher/56x56-edge
edge1050.resourcePath = $(edge1050.resourcePath);resources-launcher/68x68-edge
# END launcher icons
